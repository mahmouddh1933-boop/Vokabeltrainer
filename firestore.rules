rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.oliveDevice is string
        && request.auth.token.oliveSession is string
        && permitted(uid);
    }
    function permitted(uid) {
      let member = get(/databases/$(database)/documents/oliveAccessUsers/$(uid)).data;
      let invitation = get(/databases/$(database)/documents/oliveAllowedEmails/$(member.emailKey)).data;
      let device = get(/databases/$(database)/documents/oliveAccessUsers/$(uid)/devices/$(request.auth.token.oliveDevice)).data;
      return member.enabled == true && invitation.enabled == true && invitation.uid == uid
        && member.email == invitation.email
        && member.email == request.auth.token.email.lower()
        && device.active == true && device.status == 'active'
        && device.id == request.auth.token.oliveDevice
        && device.sessionId == request.auth.token.oliveSession
        && member.devices is map && member.devices.keys().size() <= 2
        && member.devices[device.id] == device.sessionId
        && device.expiresAtMs > request.time.toMillis();
    }
    function known(key) {
      return key in ['learningStats', 'wrongWords', 'studiedWords', 'listMasteryV12',
        'vocabList', 'arabicList', 'currentVocabSource', 'testResults', 'lastTestOutcomeV12',
        'vocabTestDurationSeconds', 'vocabInterfaceLanguage', 'lettersLanguage', 'oliveLearnerThemeV1',
        'jisrPracticeV1:sounds', 'jisrPracticeV1:sentences', 'jisrPracticeV1:stories',
        'jisrPracticeV1:book-two', 'jisrPracticeV1:arabic-youth', 'jisrPracticeV1:youth-two',
        'jisrPracticeV1:youth-book-two-part-one'];
    }
    match /users/{uid}/learning/{key} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && known(key)
        && request.resource.data.keys().hasOnly(['schema', 'revision', 'value', 'applied', 'updatedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && (request.resource.data.value == null || (request.resource.data.value is string && request.resource.data.value.size() <= 600000))
        && request.resource.data.applied is map && request.resource.data.applied.size() <= 1024
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /users/{uid}/sync/state {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['schema', 'version', 'records', 'updatedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.version is int
        && request.resource.data.version == (resource == null ? 1 : resource.data.version + 1)
        && request.resource.data.records is map && request.resource.data.records.size() <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

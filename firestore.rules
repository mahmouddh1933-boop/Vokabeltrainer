rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^/]+$');
    }
    function admin() {
      return verified()
        && exists(/databases/$(database)/documents/oliveFreeAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/oliveFreeAdmins/$(request.auth.uid)).data.enabled == true;
    }
    function permitted() {
      return verified() && (admin()
        || (exists(/databases/$(database)/documents/oliveFreeEmails/$(request.auth.token.email.lower()))
          && get(/databases/$(database)/documents/oliveFreeEmails/$(request.auth.token.email.lower())).data.enabled == true));
    }
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid && permitted();
    }
    // Device entries describe browser-reported usage, not token-bound identity.
    // The email list, admin role and account isolation are enforced separately.
    function validUsage() {
      let next = request.resource.data;
      let id = next.touchedDevice;
      let entry = next.devices[id];
      return next.keys().hasOnly(['email','devices','touchedDevice','createdAt','lastSeenAt'])
        && next.email == request.auth.token.email.lower()
        && next.createdAt is timestamp && next.lastSeenAt == request.time
        && id is string && id.matches('^[a-f0-9]{64}$')
        && next.devices is map && next.devices.size() >= 1 && next.devices.size() <= 2
        && entry is map && entry.keys().hasOnly(['label','agent','firstSeenAt','lastSeenAt'])
        && entry.label is string && entry.label.size() <= 120
        && entry.agent is string && entry.agent.size() <= 240
        && entry.firstSeenAt is timestamp && entry.lastSeenAt == request.time
        && !exists(/databases/$(database)/documents/oliveFreeMembers/$(request.auth.uid)/deviceBlocks/$(id));
    }
    match /oliveFreeAdmins/{uid} {
      // Only a project owner can seed roles through Console/Admin SDK.
      allow get: if verified() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /oliveFreeEmails/{email} {
      allow get: if admin() || (verified() && request.auth.token.email.lower() == email);
      allow list: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['email','enabled','createdAt','updatedAt'])
        && request.resource.data.email == email && email == email.lower()
        && request.resource.data.enabled is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /oliveFreeMembers/{uid} {
      allow get: if admin() || owner(uid);
      allow list: if admin();
      allow create: if admin() || (owner(uid) && validUsage()
        && request.resource.data.devices.size() == 1
        && request.resource.data.createdAt == request.time);
      allow update: if admin() || (owner(uid) && validUsage()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.devices.keys().hasAll(resource.data.devices.keys())
        && request.resource.data.devices.diff(resource.data.devices).affectedKeys().hasOnly([request.resource.data.touchedDevice]));
      allow delete: if admin();
      match /deviceBlocks/{id} {
        allow get: if admin() || owner(uid);
        allow list, write: if admin();
      }
    }
    function known(key) {
      return key in ['learningStats', 'wrongWords', 'studiedWords', 'listMasteryV12',
        'vocabList', 'arabicList', 'currentVocabSource', 'testResults', 'lastTestOutcomeV12',
        'vocabTestDurationSeconds', 'vocabInterfaceLanguage', 'lettersLanguage', 'oliveLearnerThemeV1',
        'jisrPracticeV1:sounds', 'jisrPracticeV1:sentences', 'jisrPracticeV1:stories',
        'jisrPracticeV1:book-two', 'jisrPracticeV1:arabic-youth', 'jisrPracticeV1:youth-two',
        'jisrPracticeV1:youth-book-two-part-one'];
    }
    match /users/{uid}/learning/{key} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && known(key)
        && request.resource.data.keys().hasOnly(['schema', 'revision', 'value', 'applied', 'updatedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && (request.resource.data.value == null || (request.resource.data.value is string && request.resource.data.value.size() <= 600000))
        && request.resource.data.applied is map && request.resource.data.applied.size() <= 1024
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /users/{uid}/sync/state {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['schema', 'version', 'records', 'updatedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.version is int
        && request.resource.data.version == (resource == null ? 1 : resource.data.version + 1)
        && request.resource.data.records is map && request.resource.data.records.size() <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

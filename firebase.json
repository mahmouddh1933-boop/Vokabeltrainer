{
  "hosting": {
    "public": "firebase-public",
    "predeploy": [
      "python3 tools/build-suite.py --directory firebase-public --hosting"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/pwa-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/js/cloud-sync*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/reading-exercises.html",
        "destination": "/start/reading-exercises.html",
        "type": 302
      },
      {
        "source": "/letters.html",
        "destination": "/start/letters.html",
        "type": 302
      },
      {
        "source": "/huruf.html",
        "destination": "/start/huruf.html",
        "type": 302
      },
      {
        "source": "/letter-tests.html",
        "destination": "/start/letter-tests.html",
        "type": 302
      },
      {
        "source": "/sounds.html",
        "destination": "/start/sounds.html",
        "type": 302
      },
      {
        "source": "/reading.html",
        "destination": "/start/reading.html",
        "type": 302
      },
      {
        "source": "/reading-trainer.html",
        "destination": "/start/reading-trainer.html",
        "type": 302
      },
      {
        "source": "/vocabulary.html",
        "destination": "/a1-a2/vocabulary.html",
        "type": 302
      },
      {
        "source": "/lernseite.html",
        "destination": "/a1-a2/lernseite.html",
        "type": 302
      },
      {

      "path": "audio/practice/089.mp3"
    },
    {
      "text": "فَاكِهَة",
      "path": "audio/practice/090.mp3"
    },
    {
      "text": "ذَهَبَ عُمَرُ وَأُخْتُهُ إِلَى الْحَدِيقَةِ صَبَاحًا.",
      "path": "audio/practice/091.mp3"
    },
    {
      "text": "حَمَلَ عُمَرُ كُرَةً.",
      "path": "audio/practice/092.mp3"
    },
    {
      "text": "لَعِبَا قُرْبَ شَجَرَةٍ كَبِيرَةٍ.",
      "path": "audio/practice/093.mp3"
    },
    {
      "text": "ثُمَّ جَلَسَا لِيَشْرَبَا الْمَاءَ.",
      "path": "audio/practice/094.mp3"
    },
    {
      "text": "رَأَيَا عُصْفُورًا صَغِيرًا عَلَى غُصْنٍ.",
      "path": "audio/practice/095.mp3"
    },
    {
      "text": "عَادَا سَعِيدَيْنِ قَبْلَ الظُّهْرِ.",
      "path": "audio/practice/096.mp3"
    },
    {
      "text": "حَدِيقَة",

      "path": "audio/practice/098.mp3"
    },
    {
      "text": "عُصْفُور",
      "path": "audio/practice/099.mp3"
    },
    {
      "text": "غُصْن",
      "path": "audio/practice/100.mp3"
    },
    {
      "text": "زَارَتْ نُورُ الْمَكْتَبَةَ بَعْدَ الْمَدْرَسَةِ.",
      "path": "audio/practice/101.mp3"
    },
    {
      "text": "أَرَادَتْ كِتَابًا عَنِ الْحَيَوَانَاتِ.",
      "path": "audio/practice/102.mp3"
    },
    {
      "text": "سَاعَدَتْهَا أَمِينَةُ الْمَكْتَبَةِ فِي الْبَحْثِ.",
      "path": "audio/practice/103.mp3"
    },
    {
      "text": "اخْتَارَتْ نُورُ كِتَابًا فِيهِ صُوَرٌ كَثِيرَةٌ.",
      "path": "audio/practice/104.mp3"
    },
    {
      "text": "اسْتَعَارَتِ الْكِتَابَ لِأُسْبُوعٍ.",
      "path": "audio/practice/105.mp3"
    },
    {
      "text": "وَعَدَتْ أَنْ تُعِيدَهُ فِي الْمَوْعِدِ.",
      "path": "audio/practice/106.mp3"
    },
    {
      "text": "مَكْتَبَة",
      "path": "audio/practice/107.mp3"
    },

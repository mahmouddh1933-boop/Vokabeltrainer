      "text": "كِتَاب",
      "path": "audio/practice/036.mp3"
    },
    {
      "text": "أَنَا طَالِبٌ",
      "path": "audio/practice/037.mp3"
    },
    {
      "text": "هِيَ طَبِيبَةٌ",
      "path": "audio/practice/038.mp3"
    },
    {
      "text": "الْبَيْتُ كَبِيرٌ",
      "path": "audio/practice/039.mp3"
    },
    {
      "text": "الْبِنْتُ صَغِيرَةٌ",
      "path": "audio/practice/040.mp3"
    },
    {
      "text": "يَقْرَأُ الْوَلَدُ كِتَابًا",
      "path": "audio/practice/041.mp3"
    },
    {
      "text": "تَشْرَبُ الْبِنْتُ حَلِيبًا",
      "path": "audio/practice/042.mp3"
    },
    {
      "text": "يَأْكُلُ الطِّفْلُ تُفَّاحَةً",
      "path": "audio/practice/043.mp3"
    },
    {
      "text": "الْكِتَابُ عَلَى الطَّاوِلَةِ",
      "path": "audio/practice/044.mp3"
    },
    {
      "text": "الْقَلَمُ فِي الْحَقِيبَةِ",
      "path": "audio/practice/045.mp3"
    },
    {
      "text": "هَذِهِ سَيَّارَةٌ جَدِيدَةٌ",
      "path": "audio/practice/046.mp3"
    },
    {
      "text": "هَذَا قَلَمٌ أَزْرَقُ",
      "path": "audio/practice/047.mp3"
    },
    {
      "text": "أَذْهَبُ إِلَى الْمَدْرَسَةِ",
      "path": "audio/practice/048.mp3"
    },
    {
      "text": "كَتَبَتْ مَرْيَمُ رِسَالَةً قَصِيرَةً",
      "path": "audio/practice/049.mp3"
    },
    {
      "text": "اشْتَرَى أَحْمَدُ خُبْزًا طَازَجًا",
      "path": "audio/practice/050.mp3"
    },
    {
      "text": "هَؤُلَاءِ طُلَّابٌ مُجْتَهِدُونَ",
      "path": "audio/practice/051.mp3"
    },
    {
      "text": "الْكُتُبُ الْجَدِيدَةُ مُفِيدَةٌ",
      "path": "audio/practice/052.mp3"
    },
    {
      "text": "كَانَ الْجَوُّ بَارِدًا",
      "path": "audio/practice/053.mp3"
    },
    {
      "text": "إِنَّ الْعِلْمَ نَافِعٌ",
      "path": "audio/practice/054.mp3"
    },
    {
      "text": "لَنْ أَتَأَخَّرَ عَنِ الدَّرْسِ",
      "path": "audio/practice/055.mp3"
    },
    {
      "text": "لَمْ يَذْهَبْ خَالِدٌ إِلَى السُّوقِ",
      "path": "audio/practice/056.mp3"
    },
    {
      "text": "جَلَسَ الطِّفْلُ بِجَانِبِ أُمِّهِ",
      "path": "audio/practice/057.mp3"
    },
    {
      "text": "وَضَعْتُ الْمِفْتَاحَ تَحْتَ الْكِتَابِ",
      "path": "audio/practice/058.mp3"
    },
    {
      "text": "نَقْرَأُ الْقِصَصَ لِنَتَعَلَّمَ الْعَرَبِيَّةَ",
      "path": "audio/practice/059.mp3"
    },
    {
      "text": "فِي الْحَدِيقَةِ شَجَرَتَانِ كَبِيرَتَانِ",
      "path": "audio/practice/060.mp3"
    },
    {
      "text": "أَنَا لَيْلَى.",
      "path": "audio/practice/061.mp3"
    },
    {
      "text": "أَجْلِسُ مَعَ أُسْرَتِي فِي الْمَطْبَخِ.",
      "path": "audio/practice/062.mp3"
    },
    {
      "text": "عَلَى الطَّاوِلَةِ خُبْزٌ وَجُبْنٌ.",
      "path": "audio/practice/063.mp3"
    },
    {
      "text": "أَشْرَبُ الْحَلِيبَ، وَيَشْرَبُ أَبِي الشَّايَ.",
      "path": "audio/practice/064.mp3"
    },
    {
      "text": "تَأْكُلُ أُخْتِي تُفَّاحَةً.",
      "path": "audio/practice/065.mp3"
    },
    {
      "text": "بَعْدَ الْفَطُورِ أَذْهَبُ إِلَى الْمَدْرَسَةِ.",
      "path": "audio/practice/066.mp3"
    },
    {
      "text": "أُسْرَة",
      "path": "audio/practice/067.mp3"
    },
    {
      "text": "مَطْبَخ",
      "path": "audio/practice/068.mp3"
    },
    {
      "text": "خُبْز",
      "path": "audio/practice/069.mp3"
    },
    {
      "text": "حَلِيب",
      "path": "audio/practice/070.mp3"
    },
    {
      "text": "هَذَا صَفِّي.",
      "path": "audio/practice/071.mp3"
    },
    {
      "text": "أَجْلِسُ بِجَانِبِ صَدِيقِي سَامِي.",
      "path": "audio/practice/072.mp3"
    },
    {
      "text": "تَكْتُبُ الْمُعَلِّمَةُ حَرْفَ الْبَاءِ عَلَى السَّبُّورَةِ.",
      "path": "audio/practice/073.mp3"
    },
    {
      "text": "يَقْرَأُ سَامِي كَلِمَةَ بَيْتٍ.",

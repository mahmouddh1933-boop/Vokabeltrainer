      "text": "تَطْبُخُ أُمِّي وَجْبَةً لَذِيذَةً",
      "path": "audio/sentence-expanded/61efda553aee5222.mp3",
      "sha256": "4124379c6300341a5ba8173d1cb3ff6458c1b0e05402c058873d7ad04de7eed6"
    },
    {
      "text": "لَبِسْتُ مِعْطَفًا لِأَنَّ الْجَوَّ بَارِدٌ",
      "path": "audio/sentence-expanded/ac1b4b50d8912c87.mp3",
      "sha256": "c0c84fd4fef0baaa0366e82815c96fe4c6ca41ebbf9201a176cfe681d3cdb93e"
    },
    {
      "text": "الْجَوُّ مَشْمِسٌ وَلَكِنَّ الرِّيحَ قَوِيَّةٌ",
      "path": "audio/sentence-expanded/29bbc89e9e5b9af6.mp3",
      "sha256": "5bbfd4fb0a60a89c081e696257fd1c485073e8bb3099946fe24fffe9f3da6ed9"
    },
    {
      "text": "كَانَ الْمَتْجَرُ مُغْلَقًا أَمْسِ",
      "path": "audio/sentence-expanded/d81f6e30b14a76d3.mp3",
      "sha256": "a133597781150cfb9713003da9ca0c16aeecb73ea4372364fa15f063ec9d935c"
    },
    {
      "text": "أَصْبَحَتِ الْحَدِيقَةُ جَمِيلَةً فِي الرَّبِيعِ",
      "path": "audio/sentence-expanded/8a68ce621d24cf3d.mp3",
      "sha256": "3ee895a732ecb59e45a7be95da948901d497a1af08972d21138095a0ce7ac5f9"
    },
    {
      "text": "لَمْ أَشْتَرِ الْحِذَاءَ لِأَنَّهُ غَالٍ",
      "path": "audio/sentence-expanded/36577816103aef11.mp3",
      "sha256": "9f5b69fd53c960effb6c5fd0cea35f5194e51380a9175979f22d0e253770afa6"
    },
    {
      "text": "لَنْ نَتَأَخَّرَ عَنِ الْمَوْعِدِ",
      "path": "audio/sentence-expanded/0f5257a0fe986c17.mp3",
      "sha256": "c16e7b31ae5dc16098758705b7a54b173139fd61ec6658d2a095f4564f27a36b"
    },
    {
      "text": "أَيْنَ يُمْكِنُنِي شِرَاءُ تَذْكِرَةٍ؟",
      "path": "audio/sentence-expanded/e9b2fad634ea6e9f.mp3",
      "sha256": "57395b2d145bd9f1961971a1fed39d58fdf9fa37194f2b6a113b661a8472fb07"
    },
    {
      "text": "مَتَى يَصِلُ الْقِطَارُ إِلَى الْمَحَطَّةِ؟",
      "path": "audio/sentence-expanded/47f39e2898ab1ec3.mp3",
      "sha256": "ff60c615cedd689cd69ff55aee8846ffc2bd4aa89343f36517761931725c5fcd"
    },
    {
      "text": "كَمْ تَسْتَغْرِقُ الرِّحْلَةُ بِالْحَافِلَةِ؟",
      "path": "audio/sentence-expanded/f2f2c7395cf0947d.mp3",
      "sha256": "79c4879bdee9b828a3a956767905dd80f63c0ecf323fbfb9861fe73fb3baa983"
    },
    {
      "text": "بِكَمْ هَذَا الْقَمِيصُ الْأَزْرَقُ؟",
      "path": "audio/sentence-expanded/f1b96ad6c877e900.mp3",
      "sha256": "e7c6442a1d47e05b6dd5cc26b9b0654c9741582cc12825db23ff0f35134066fb"
    },
    {
      "text": "هَلْ عِنْدَكَ مَقَاسٌ أَصْغَرُ؟",
      "path": "audio/sentence-expanded/74b01435a4616da1.mp3",
      "sha256": "ff55bd8df88dcac6a69b0d36b5681a8fc038cc53503c72ebf8874f7159324909"
    },
    {
      "text": "مَاذَا تُفَضِّلُ لِوَجْبَةِ الْإِفْطَارِ؟",
      "path": "audio/sentence-expanded/acaab12f9edcf662.mp3",
      "sha256": "e88760e25ce58a3fc3f9573beb953c584b83544c74407dd006ba82d36752252a"
    },
    {
      "text": "لِمَاذَا ذَهَبْتَ إِلَى الطَّبِيبِ؟",
      "path": "audio/sentence-expanded/1e78b2e33de60587.mp3",
      "sha256": "4180ccceab2a8e7cb27430b58aff2069aaa21afde7e7ac278c857df30d1e74d8"
    },
    {
      "text": "كَيْفَ أَصِلُ إِلَى الْمُسْتَشْفَى؟",
      "path": "audio/sentence-expanded/511514aaa5ad3452.mp3",
      "sha256": "d10b41accf8bc7b1fbedccbd14b7a7d5ce54663385d6fc416a737442d690a768"
    },
    {
      "text": "أَيُّ حَافِلَةٍ تَذْهَبُ إِلَى الْمَطَارِ؟",
      "path": "audio/sentence-expanded/b466479f13844f1b.mp3",
      "sha256": "448edc27bab9ae20f5f06d69d811c4eb77eea81e8aca6d19b80c5bbef4e0997a"
    },
    {
      "text": "هَلْ تَسْتَطِيعُ مُسَاعَدَتِي؟",
      "path": "audio/sentence-expanded/ffb8472b4dc4064b.mp3",
      "sha256": "e776c9524e2ad099df86b56e0110221279d4c416e7b5f4ee559554cc8920dab1"
    },
    {
      "text": "مَعَ مَنْ سَافَرْتَ أَمْسِ؟",
      "path": "audio/sentence-expanded/d68a5792e3b6d6b8.mp3",
      "sha256": "82db0c2b4f0c50c4b851bc2a9d65abc785bf1f640be2c082cada35ace66b6613"
    },
    {
      "text": "مَاذَا فَعَلْتَ فِي نِهَايَةِ الْأُسْبُوعِ؟",
      "path": "audio/sentence-expanded/f249f3350b9c3c28.mp3",
      "sha256": "f307f182750b0cc41553a5c8fa11bd536e1708b278a4daa722ec379535f97373"
    },
    {
      "text": "كَمْ مَرَّةً تُمَارِسُ الرِّيَاضَةَ فِي الْأُسْبُوعِ؟",
      "path": "audio/sentence-expanded/5d751b424750ec20.mp3",
      "sha256": "75e07a20747bdaf5bee6e27d1242c8191d9260de083d4909b1b057c8d1e0f47a"
    },
    {
      "text": "هَلْ يُوجَدُ مَطْعَمٌ قَرِيبٌ مِنْ هُنَا؟",
      "path": "audio/sentence-expanded/46496511eab9714d.mp3",
      "sha256": "d040b9c1c567ad0b0c6a841606d8970cde01158ea0a2793e4ba52e7d918bcc1f"
    },
    {
      "text": "مَتَى يَبْدَأُ الْعَمَلُ؟",
      "path": "audio/sentence-expanded/595850fc2a309ad1.mp3",
      "sha256": "434926d41e022427f834b7632fe469d7eebf8638fca91212828d40b6bd2732cf"
    },
    {
      "text": "لِمَاذَا لَمْ تَحْضُرِ الدَّرْسَ أَمْسِ؟",
      "path": "audio/sentence-expanded/13e22d2220871934.mp3",
      "sha256": "d8a8e2a4fb9cb3f0928f483b6a1038a643bcf842be60254ad56b0ec0d379774e"
    },
    {
      "text": "اِنْعَطِفْ يَمِينًا عِنْدَ الْإِشَارَةِ",
      "path": "audio/sentence-expanded/3cc408fbd6ad8bc1.mp3",
      "sha256": "891912583c342c1bd9e4a5ad47092db0e908dbff05236bdbc87717bfe4d22acf"
    },
    {
      "text": "اِمْشِ مُسْتَقِيمًا حَتَّى الْمَحَطَّةِ",
      "path": "audio/sentence-expanded/8540fda596eefbd0.mp3",
      "sha256": "788c3ee91fd0af91403212e53341916901d5c838c7bdc007b247da0de04c35cb"
    },
    {
      "text": "لَا تَعْبُرِ الشَّارِعَ الْآنَ",
      "path": "audio/sentence-expanded/71d3dcb908c85847.mp3",
      "sha256": "5b88513ea27693c35d4d150ebddfcd32351ea05f981de5ed551c9de856cfd145"
    },
    {
      "text": "خُذْ هَذَا الدَّوَاءَ بَعْدَ الطَّعَامِ",
      "path": "audio/sentence-expanded/265e1259347519ad.mp3",
      "sha256": "00862458609315115a8105abdb5caa96b7ebcdb53ac9feb36d69b19aed90c7b9"
    },
    {
      "text": "عِنْدَمَا يَنْتَهِي الدَّرْسُ نَذْهَبُ إِلَى الْمَكْتَبَةِ",
      "path": "audio/sentence-expanded/8e24729356fd1ef9.mp3",
      "sha256": "fb27bd2537065d85f6d9ce3160dd443cd855dd859143dc3d942c0cc493e0298e"
    },
    {
      "text": "أَدْرُسُ الْعَرَبِيَّةَ كَيْ أَقْرَأَ الْقِصَصَ",
      "path": "audio/sentence-expanded/a74bc7ac23cec9a4.mp3",
      "sha256": "374c4646109ebf749c762465f64814d8cff2fd5fa362890a05d66f85c51f29e7"
    },
    {
      "text": "قَرَأْتُ قِصَّةً قَصِيرَةً ثُمَّ كَتَبْتُ رِسَالَةً",
      "path": "audio/sentence-expanded/aa92ab993306f43c.mp3",
      "sha256": "384a85b282d30ff103d69d6e7576ef2a324fe1b73dded4e8fbde3348d8b4cc6f"
    },
    {
      "text": "أُحِبُّ السَّفَرَ لَكِنِّي أُفَضِّلُ الْقِطَارَ",
      "path": "audio/sentence-expanded/da47665fa69f2b33.mp3",
      "sha256": "7243b4b80054760afc222c7533b1b02b1be54d9b34e92c11368cfb2cff1b9a7a"
    }
  ]
}
